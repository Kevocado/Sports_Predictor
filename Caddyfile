# Sports Predictor - Caddy reverse proxy
:80 {
    root * /usr/share/caddy

    # handle/handle_path blocks at the same level are mutually exclusive,
    # first-match-wins alternatives -- confirmed live this is required:
    # a bare (non-handle-wrapped) root/try_files/file_server below sorts
    # into Caddy's fixed default directive order regardless of where it's
    # written in this file, so it served the SPA's index.html fallback for
    # every request -- including /nfl/* and /cfb/* -- even with the
    # handle_path blocks appearing first in the file. Wrapping the fallback
    # in its own handle{} makes the three blocks genuinely exclusive.
    handle_path /nfl/* {
        reverse_proxy nfl-predictor.internal.proudbay-f56b8dfa.eastus2.azurecontainerapps.io:8001
    }
    handle_path /cfb/* {
        reverse_proxy cfb-predictor.internal.proudbay-f56b8dfa.eastus2.azurecontainerapps.io:8003
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
