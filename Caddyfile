# Sports Predictor - Caddy reverse proxy
:80 {
    root * /usr/share/caddy

    # handle/handle_path blocks at the same level are mutually exclusive,
    # first-match-wins alternatives -- confirmed live this is required:
    # a bare (non-handle-wrapped) root/try_files/file_server below sorts
    # into Caddy's fixed default directive order regardless of where it's
    # written in this file, so it served the SPA's index.html fallback for
    # every request -- including /nfl/* and /cfb/* -- even with the
    # handle_path blocks appearing first in the file. Wrapping the fallback
    # in its own handle{} makes the three blocks genuinely exclusive.
    # Both backends: public FQDNs (external ingress) -- the old
    # .internal.proudbay... hostnames only resolve inside the Azure
    # Container Apps Environment and are unreachable from the Caddy container.
    # handle_path strips /nfl/ before forwarding, so /nfl/api/games reaches
    # the NFL backend at /api/games. min-replicas 0 (scale-to-zero):
    # confirmed live: a cold nfl-predictor/cfb-predictor
    # made Caddy's default ~3s dial timeout fail with "i/o timeout" well
    # before the backend finished waking up. 30s comfortably covers a cold
    # start (matches the Azure migration plan's own cold-start expectation)
    # without leaving a genuinely-down backend hanging indefinitely.
    handle_path /nfl/* {
        reverse_proxy nfl-predictor.proudbay-f56b8dfa.eastus2.azurecontainerapps.io:8001 {
            transport http {
                dial_timeout 30s
                response_header_timeout 30s
            }
        }
    }
    handle_path /cfb/* {
        reverse_proxy cfb-predictor.proudbay-f56b8dfa.eastus2.azurecontainerapps.io:8003 {
            transport http {
                dial_timeout 30s
                response_header_timeout 30s
            }
        }
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
